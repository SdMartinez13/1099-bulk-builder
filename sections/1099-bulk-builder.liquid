{{ '1099-builder-contrast.css' | asset_url | stylesheet_tag }}
{% assign markup_multiplier = section.settings.garment_markup_percent | divided_by: 100.0 | plus: 1 %}
<section id="bulk-builder-{{ section.id }}" class="bb1099" data-markup="{{ markup_multiplier }}">
<style>
#bulk-builder-{{ section.id }}{background:#070707;color:#fff;padding:34px 18px 54px}.bb1099 .bbwrap{max-width:1050px;margin:auto}.bb1099 h1,.bb1099 h2{color:#fff!important}.bb1099 h1{font-size:clamp(36px,5vw,58px);line-height:1.05;margin-bottom:18px}.bb1099 .eyebrow,.bb1099 .stepno{color:#d51f2b;font-weight:800;letter-spacing:.14em}.bb1099 .muted{color:#aaa}.bb1099 .step{border:1px solid #333;padding:18px 22px;margin:14px 0}.bb1099 .step h2{margin:10px 0 18px}.bb1099 #bbgarmentpreview{margin-top:18px!important;padding:20px;background:#0d0d0d;border:1px solid #2b2b2b;text-align:center!important}.bb1099 #bbgarmentimg{display:block;max-width:300px!important;width:100%!important;height:300px!important;object-fit:contain;margin:0 auto;border-radius:0!important;background:#fff}.bb1099 .garmentcaption{margin-top:14px;font-size:14px;font-weight:800;letter-spacing:.04em;color:#fff}.bb1099 .garmentcaption span{color:#aaa;font-weight:500}.bb1099 .printcontrol{background:#0d0d0d;border:1px solid #333;padding:16px}.bb1099 .printcontrol label{font-size:14px;font-weight:900;color:#fff;margin-bottom:9px}.bb1099 .printcontrol select{font-size:16px;font-weight:700}.bb1099 .controlhint{font-size:12px;color:#888;margin-top:9px;line-height:1.4}.bb1099 .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.bb1099 .sizes{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}.bb1099 .sizes>div{background:#0d0d0d;border:1px solid #333;padding:12px;text-align:center;transition:border-color .15s,background .15s}.bb1099 .sizes>div:focus-within{border-color:#d51f2b;background:#121212}.bb1099 .sizes>div.hasqty{border-color:#d51f2b;background:#161010}.bb1099 .sizes>div.hasqty label{color:#fff}.bb1099 .sizes>div label{font-size:16px;font-weight:900;color:#fff;margin-bottom:9px}.bb1099 .sizes .bbqty{text-align:center;font-size:18px;font-weight:800;padding:11px 6px}.bb1099 label{display:block;color:#ccc;font-size:12px;margin-bottom:6px}.bb1099 select,.bb1099 input{width:100%;box-sizing:border-box;background:#111;color:#fff;border:1px solid #444;padding:12px}.bb1099 input[type=file]{padding:10px}.bb1099 .artworkbox{background:#0d0d0d;border:1px dashed #555;padding:28px 22px;text-align:center}.bb1099 .artworktitle{font-size:18px;font-weight:900;letter-spacing:.06em;color:#fff}.bb1099 .artworksub{font-size:13px;color:#999;margin:8px 0 18px}.bb1099 .artworkbutton{display:inline-block;background:#fff;color:#111!important;padding:13px 20px;margin:0;cursor:pointer;font-size:13px;font-weight:900;letter-spacing:.08em;transition:background .15s,color .15s}.bb1099 .artworkbutton:hover{background:#d51f2b;color:#fff!important}.bb1099 .artworkinput{position:absolute!important;width:1px!important;height:1px!important;opacity:0!important;overflow:hidden!important;padding:0!important;border:0!important}.bb1099 .artworkfilename{font-size:12px;color:#aaa;margin-top:12px}.bb1099 .artworkbox .fine{margin-bottom:0}.bb1099 .quote{background:#fff;color:#111;padding:22px;margin-top:18px}.bb1099 .quote h2{color:#111!important;margin-top:0}.bb1099 .total{font-size:38px;font-weight:900}.bb1099 .qgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px 24px}.bb1099 .btn{width:100%;border:0;padding:15px;font-weight:900;letter-spacing:.08em;cursor:pointer}.bb1099 .checkout{background:#d51f2b;color:#fff;margin-top:16px}.bb1099 .checkout:disabled{opacity:.45;cursor:not-allowed}.bb1099 .status{font-size:13px;margin-top:10px;min-height:20px}.bb1099 .fine{font-size:12px;color:#777;margin-top:12px}@media(max-width:700px){.bb1099 .grid{grid-template-columns:1fr}.bb1099 .sizes{grid-template-columns:repeat(4,1fr)}.bb1099 .qgrid{grid-template-columns:1fr}.bb1099 .total{font-size:32px}}
</style>
<div class="bbwrap"><div class="eyebrow">1099 DESIGNS / CUSTOM APPAREL</div><h1>{{ section.settings.heading }}</h1><p class="muted">Pick your garment, enter your sizes, choose your print setup and upload your artwork. Your bulk price updates instantly.</p>
<div class="step"><div class="stepno">01</div><h2>CHOOSE YOUR GARMENT</h2><div class="grid"><div><label>Style</label><select id="bbstyle"><option value="PC450">PC450 — Core Cotton Tee</option><option value="G5000">Gildan G5000 — Heavy Cotton T-Shirt</option><option value="G18500">Gildan Heavy Blend Hoodie — 18500</option></select></div><div><label>Color</label><select id="bbcolor"><option value="Athletic Heather">Athletic Heather</option></select></div></div></div>
<div id="bbgarmentpreview" style="margin-top:18px;text-align:center"><img id="bbgarmentimg" src="https://cdn.shopify.com/s/files/1/0763/1677/0470/files/1099-test-pc450-athletic-heather.png?v=1789518236" alt="Selected garment preview" width="300" height="300" style="max-width:260px;width:100%;height:auto;border-radius:8px"><div class="garmentcaption" id="bbgarmentcaption">PC450 — Core Cotton Tee<br><span>Athletic Heather</span></div></div><div class="step"><div class="stepno">02</div><h2>ENTER YOUR SIZES</h2><div class="sizes">{% assign sizes='S,M,L,XL,2XL,3XL,4XL' | split:',' %}{% for s in sizes %}<div><label>{{ s }}</label><input class="bbqty" data-size="{{ s }}" type="number" min="0" value="0"></div>{% endfor %}</div></div>
<div class="step"><div class="stepno">03</div><h2>PRINT SETUP</h2><div class="grid printsetup"><div class="printcontrol"><label>Print location</label><select id="bbloc"><option>Front</option><option>Back</option></select><div class="controlhint">Choose which side of the garment receives the print.</div></div><div class="printcontrol"><label>Artwork width</label><select id="bbw">{% assign widths='1.5,2,3,3.5,4,5,6,7,8,9,10,10.5,11,12,13,14,15,16' | split:',' %}{% for w in widths %}<option value="{{ w }}" {% if w == '8' %}selected{% endif %}>{{ w }}&quot;</option>{% endfor %}</select><div class="controlhint">Finished print width in inches.</div></div></div></div>
<div class="step"><div class="stepno">04</div><h2>YOUR ARTWORK</h2><label>Upload artwork (optional)</label><input id="bbart" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml,application/pdf"><p class="fine">PNG, JPG, WEBP, SVG or PDF. Don&apos;t have your artwork ready? No problem—you can send it to us after placing your order.</p></div>
<div class="quote"><div class="eyebrow">LIVE BULK PRICING</div><h2>Order subtotal</h2><div class="total" id="bbtotal">$0.00</div><div class="qgrid"><div>Average per shirt</div><strong id="bbavg">$0.00</strong><div>Total shirts</div><strong id="bbcount">0</strong><div>Garments</div><strong id="bbgarments">$0.00</strong><div>DTF printing</div><strong id="bbdtf">$0.00</strong><div>Quantity tier</div><strong id="bbtier">—</strong></div><button type="button" id="bbcheckout" class="btn checkout" disabled>CREATE SECURE CHECKOUT</button><div id="bbstatus" class="status"></div><div class="fine">Estimate before tax and shipping. Final artwork is reviewed before production.</div></div></div></section>
<script>
(()=>{const r=document.getElementById('bulk-builder-{{ section.id }}');if(!r)return;const qs=[...r.querySelectorAll('.bbqty')],w=r.querySelector('#bbw'),markup=+r.dataset.markup||2;const prices={'1.5':[1,.8,.65,.55,.45],'2':[1.5,1.2,.98,.83,.68],'3':[2,1.6,1.3,1.1,.9],'3.5':[2.25,1.8,1.46,1.24,1.01],'4':[2.5,2,1.63,1.38,1.13],'5':[3,2.4,1.95,1.65,1.35],'6':[3.25,2.6,2.11,1.79,1.46],'7':[3.5,2.8,2.28,1.93,1.58],'8':[3.75,3,2.44,2.06,1.69],'9':[4,3.2,2.6,2.2,1.8],'10':[4.25,3.4,2.76,2.34,1.91],'10.5':[4.5,3.6,2.93,2.48,2.03],'11':[4.5,3.6,2.93,2.48,2.03],'12':[5.5,4.4,3.58,3.03,2.48],'13':[6,4.8,3.9,3.3,2.7],'14':[7,5.6,4.55,3.85,3.15],'15':[8,6.4,5.2,4.4,3.6],'16':[9,7.2,5.85,4.95,4.05]};const tier=n=>n>=250?[4,'250+']:n>=100?[3,'100–249']:n>=50?[2,'50–99']:n>=10?[1,'10–49']:[0,'1–9'];const money=n=>'$'+n.toFixed(2);let quote=null;
const style=r.querySelector('#bbstyle'),color=r.querySelector('#bbcolor');
const garmentCosts={
  PC450:{
    'Athletic Heather':{
      S:2.89,M:2.89,L:2.89,XL:2.89,'2XL':4.58,'3XL':5.97,'4XL':5.97
    }
  },
  G5000:{
    Black:{S:3.00,M:3.00,L:3.00,XL:3.00,'2XL':6.00,'3XL':6.00,'4XL':7.00},
    White:{S:3.00,M:3.00,L:3.00,XL:3.00,'2XL':6.00,'3XL':6.00,'4XL':7.00},
    Blue:{S:3.00,M:3.00,L:3.00,XL:3.00,'2XL':6.00,'3XL':6.00,'4XL':7.00},
    Red:{S:3.00,M:3.00,L:3.00,XL:3.00,'2XL':6.00,'3XL':6.00,'4XL':7.00},
    Gray:{S:3.00,M:3.00,L:3.00,XL:3.00,'2XL':6.00,'3XL':6.00,'4XL':7.00},
    Tan:{S:3.00,M:3.00,L:3.00,XL:3.00,'2XL':6.00,'3XL':6.00,'4XL':7.00}
  },
  G18500:{
    Black:{S:10.15,M:10.15,L:10.15,XL:10.15,'2XL':12.73,'3XL':15.21,'4XL':15.21},
    White:{S:10.15,M:10.15,L:10.15,XL:10.15,'2XL':12.73,'3XL':15.21,'4XL':15.21},
    Gray:{S:10.15,M:10.15,L:10.15,XL:10.15,'2XL':12.73,'3XL':15.21,'4XL':15.21},
    Red:{S:10.15,M:10.15,L:10.15,XL:10.15,'2XL':12.73,'3XL':15.21,'4XL':15.21},
    Tan:{S:10.15,M:10.15,L:10.15,XL:10.15,'2XL':12.73,'3XL':15.21,'4XL':15.21}
  }
};
const garmentColors={
  PC450:['Athletic Heather'],
  G5000:['Black','White','Blue','Red','Gray','Tan'],
  G18500:['Black','White','Gray','Red','Tan']
};
const garmentImages={
  PC450:{
    'Athletic Heather':'https://cdn.shopify.com/s/files/1/0763/1677/0470/files/1099-test-pc450-athletic-heather.png?v=1789518236'
  },
  G5000:{
    Black:'https://cdn.shopify.com/s/files/1/0763/1677/0470/files/g5000-black.png?v=1789521592',
    White:'https://cdn.shopify.com/s/files/1/0763/1677/0470/files/g5000-white.png?v=1789521601',
    Blue:'https://cdn.shopify.com/s/files/1/0763/1677/0470/files/g5000-blue.png?v=1789521610',
    Red:'https://cdn.shopify.com/s/files/1/0763/1677/0470/files/g5000-red.png?v=1789521619',
    Gray:'https://cdn.shopify.com/s/files/1/0763/1677/0470/files/g5000-gray.png?v=1789521628',
    Tan:'https://cdn.shopify.com/s/files/1/0763/1677/0470/files/g5000-tan.png?v=1789521637'
  }
};
function updateGarmentPreview(){
  const img=r.querySelector('#bbgarmentimg');
  const src=garmentImages[style.value]?.[color.value];
  if(img){
    if(src){
      img.src=src;
      img.style.display='block';
    } else {
      img.style.display='none';
    }
  }
  const caption=r.querySelector('#bbgarmentcaption');
  if(caption){
    const garmentName=
      style.value==='G5000'
        ? 'Gildan G5000 — Heavy Cotton T-Shirt'
        : style.value==='G18500'
          ? 'Gildan Heavy Blend Hoodie — 18500'
          : 'PC450 — Core Cotton Tee';
    caption.innerHTML=garmentName+'<br><span>'+color.value+'</span>';
  }
}
function updateColors(){
  const colors=garmentColors[style.value]||[];
  color.innerHTML=colors.map(c=>`<option value="${c}">${c}</option>`).join('');
  updateGarmentPreview();
  calc();
}
style.addEventListener('change',updateColors);
color.addEventListener('change',()=>{updateGarmentPreview();calc();});

function calc(){qs.forEach(i=>i.parentElement.classList.toggle('hasqty',Math.max(0,+i.value||0)>0));let n=0,g=0,sizes={};const costs=garmentCosts[style.value]?.[color.value];if(!costs){quote={n:0,g:0,dtf:0,total:0,sizes:{},rate:0,tier:'—'};r.querySelector('#bbcount').textContent='0';r.querySelector('#bbgarments').textContent='$0.00';r.querySelector('#bbdtf').textContent='$0.00';r.querySelector('#bbtotal').textContent='Pricing pending';r.querySelector('#bbavg').textContent='—';r.querySelector('#bbtier').textContent='—';r.querySelector('#bbcheckout').disabled=true;r.querySelector('#bbstatus').textContent='Pricing for this garment/color is not configured yet.';return;}r.querySelector('#bbstatus').textContent='';qs.forEach(i=>{const q=Math.max(0,+i.value||0);n+=q;const cost=costs[i.dataset.size];if(q&&cost!=null)g+=q*cost*markup;if(q)sizes[i.dataset.size]=q});const t=tier(n),rate=prices[w.value][t[0]],dtf=n*rate,total=g+dtf;quote={n,g,dtf,total,sizes,rate,tier:t[1]};r.querySelector('#bbcount').textContent=n;r.querySelector('#bbgarments').textContent=money(g);r.querySelector('#bbdtf').textContent=money(dtf);r.querySelector('#bbtotal').textContent=money(total);r.querySelector('#bbavg').textContent=n?money(total/n):'$0.00';r.querySelector('#bbtier').textContent=n?t[1]+' @ '+money(rate)+'/print':'—';r.querySelector('#bbcheckout').disabled=!n}
qs.forEach(i=>i.addEventListener('input',calc));w.addEventListener('change',calc);

const artworkInput=r.querySelector('#bbart');
let checkoutUrlReady='';

function goToCheckout(url){
  try{
    const a=document.createElement('a');
    a.href=url;
    a.target='_top';
    a.rel='noopener';
    document.body.appendChild(a);
    a.click();
    a.remove();
  }catch(_){
    window.location.href=url;
  }
}

r.querySelector('#bbcheckout').addEventListener('click',async()=>{
  if(checkoutUrlReady){
    goToCheckout(checkoutUrlReady);
    return;
  }

  calc();
  if(!quote||!quote.n)return;

  const b=r.querySelector('#bbcheckout');
  const st=r.querySelector('#bbstatus');

  b.disabled=true;
  b.textContent='BUILDING ORDER…';
  st.textContent='Confirming pricing and creating your secure checkout…';

  const artworkFile=artworkInput?.files?.[0]||null;

  const formData=new FormData();
  formData.append('garment',r.querySelector('#bbstyle').value);
  formData.append('color',r.querySelector('#bbcolor').value);
  formData.append('printLocation',r.querySelector('#bbloc').value);
  formData.append('printWidth',w.value);
  formData.append('sizes',JSON.stringify(quote.sizes));

  if(artworkFile){
    formData.append('artwork',artworkFile,artworkFile.name);
  }

  try{
    const controller=new AbortController();
    const timeout=setTimeout(()=>controller.abort(),30000);

    const res=await fetch('/apps/1099-builder',{
      method:'POST',
      headers:{
        'Accept':'application/json'
      },
      body:formData,
      signal:controller.signal
    });

    clearTimeout(timeout);

    const raw=(await res.text()).trim();

    if(!res.ok){
      let message='Unable to create checkout';
      try{
        const data=JSON.parse(raw);
        message=data.error||(data.errors&&data.errors.map(e=>e.message).join(', '))||message;
      }catch(_){
        if(raw) message=raw;
      }
      throw new Error(message);
    }

    let checkoutUrl='';
    try{
      const data=JSON.parse(raw);
      checkoutUrl=data.invoiceUrl||data.draftOrder?.invoiceUrl||'';
    }catch(_){
      const match=raw.match(/https:\/\/[^"'<>\\s]+\/invoices\/[^"'<>\\s]+/i);
      checkoutUrl=match?.[0]||'';
    }
    if(!/^https:\/\//i.test(checkoutUrl)){
      throw new Error('Shopify did not return a checkout URL');
    }

    checkoutUrlReady=checkoutUrl;
    st.textContent='SUCCESS — secure checkout created. Opening checkout…';
    b.disabled=false;
    b.textContent='CONTINUE TO CHECKOUT →';

    goToCheckout(checkoutUrl);
  }catch(e){
    st.textContent=e.name==='AbortError'
      ? 'Checkout request timed out after 30 seconds.'
      : 'Could not create checkout: '+e.message;
    b.disabled=false;
    b.textContent='CREATE SECURE CHECKOUT';
  }
});calc()})();
</script>
{% schema %}{"name":"1099 Bulk Builder","settings":[{"type":"text","id":"heading","label":"Heading","default":"BUILD YOUR BULK ORDER"},{"type":"range","id":"garment_markup_percent","label":"Garment markup %","min":0,"max":300,"step":5,"default":100}],"presets":[{"name":"1099 Bulk Builder"}]}{% endschema %}